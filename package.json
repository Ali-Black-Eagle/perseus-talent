{
  "name": "perseus-talent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/e2e.spec.ts",
    "check:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "check:seo": "playwright test tests/e2e/seo.spec.ts",
    "test:admin": "playwright test -c playwright.admin.config.ts",
    "check:links": "node scripts/check-links.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:lighthouse": "node scripts/lighthouse-runner.mjs",
    "build:offline": "node scripts/generate-offline-html.mjs",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3000",
    "verify:e2e": "node scripts/verify-all.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run audit:content && node scripts/verify-browser.mjs",
    "brand:logo": "node scripts/build-logo.mjs"
  },
  "dependencies": {
    "@keystatic/core": "^0.6.10",
    "@keystatic/next": "^5.0.5",
    "gray-matter": "^4.0.3",
    "libphonenumber-js": "^1.11.19",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.3",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
