# Perseus Talent Environment Configuration
# Localhost defaults - no paid services or external accounts required.
# For the live site, set these in Netlify (Site configuration > Environment variables). See DEPLOYMENT.md.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false

# How enquiries are delivered: local (saved on this computer), smtp (Gmail), or resend
FORM_DELIVERY=local

# Where notification emails go. One address, or several separated by commas, e.g.
#   ENQUIRY_TO_ADDRESS=Perseustalent@gmail.com,second.address@example.com
# (Gmail sometimes only shows mail you send to yourself in the inbox and not under "Sent",
#  so a second address can be added if you want to see every enquiry in a second mailbox.)
ENQUIRY_TO_ADDRESS=Perseustalent@gmail.com

# Send the person who filled in a form a short "thank you, we have received it" email.
# Only applies when FORM_DELIVERY is smtp or resend. Default: false.
SEND_ACKNOWLEDGEMENT=false

# SMTP configuration (only needed when FORM_DELIVERY=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=

# Resend configuration (only needed when FORM_DELIVERY=resend after domain setup)
RESEND_API_KEY=
ENQUIRY_FROM_ADDRESS=

# Cloudflare Turnstile anti-spam (set TURNSTILE_ENABLED=true plus both keys to switch it on)
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Content flags (set SHOW_DRAFTS=false on the live site)
SHOW_DRAFTS=true
