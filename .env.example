# Perseus Talent Environment Configuration
# Localhost defaults - no paid services or external accounts required

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
FORM_DELIVERY=local
ENQUIRY_TO_ADDRESS=Perseustalent@gmail.com

# SMTP configuration (only needed when FORM_DELIVERY=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=

# Resend configuration (only needed when FORM_DELIVERY=resend after domain setup)
RESEND_API_KEY=
ENQUIRY_FROM_ADDRESS=

# Cloudflare Turnstile anti-spam
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Content flags
SHOW_DRAFTS=true
